APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pousada
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Disco padrão de mídia: `public` (storage/app/public) ou `s3` (Cloudflare R2).
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Em produção defina true (exige HTTPS). Deixe comentado para o padrão.
# SESSION_SECURE_COOKIE=true

# Validade do token do app em minutos (padrão: 30 dias).
# SANCTUM_EXPIRATION=43200

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (usado quando FILESYSTEM_DISK=s3).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_URL=
R2_ROOT=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=false
# Opcional: derivado de R2_ACCOUNT_ID quando vazio.
R2_ENDPOINT=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_PASS=

# Gateway de pagamentos das assinaturas (checkout transparente no painel).
# PAGBANK_PUBLIC_KEY é opcional: quando vazia, a chave é buscada na conta.
PAGBANK_SANDBOX=true
PAGBANK_TOKEN=
PAGBANK_PUBLIC_KEY=
PAGBANK_WEBHOOK_URL=
# Token da conta para validar o header X-Authenticity-Token (SHA-256).
PAGBANK_WEBHOOK_TOKEN=
# Opcional: IPs do gateway separados por vírgula.
PAGBANK_WEBHOOK_IPS=
